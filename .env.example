# GEMINI_API_KEY: Required for Gemini AI API calls (Smart Pricing, Crop Advisory, Demand Forecast).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Required for the Interactive Agri-Ecosystem Map and geospatial coordinates.
# Generated automatically by Google Maps Platform setup or Cloud Console.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Optional client-side fallback if deploying frontend independently:
# VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT=3000

# NODE_ENV: Set to 'production' on deployment server (Cloud Run, Render, Railway, VPS)
NODE_ENV="production"
